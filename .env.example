# GitHub Container Registry image
OPENCLASH_IMAGE=ghcr.io/gbcdef/openclash-docker:latest
CONTAINER_NAME=openclash
RESTART_POLICY=unless-stopped
TZ=Asia/Shanghai

# Path to the LuCI root password Compose secret.
ROOT_PASSWORD_FILE=./secrets/root_password.txt

# Host directory for persistent OpenWrt and OpenClash data.
DATA_DIR=./data

# Host network. Set the physical LAN interface and an IPv4 address that is
# already assigned to that interface.
HOST_LAN_INTERFACE=CHANGE_ME
LUCI_BIND=127.0.0.1

# OpenClash standard ports, with HTTP/mixed swapped so mixed stays on 7890.
LUCI_PORT=18080
HTTP_PROXY_PORT=7893
SOCKS_PROXY_PORT=7891
REDIR_PROXY_PORT=7892
MIXED_PROXY_PORT=7890
TPROXY_PORT=7895
DNS_PORT=7874
CONTROLLER_PORT=9090

# Set to 1 after OpenClash is configured to require its core, TUN, policy
# routing, DNS, and mixed proxy listener to pass the container healthcheck.
REQUIRE_OPENCLASH_HEALTHY=0
